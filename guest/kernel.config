# The guest kernel's config fragment, both arches (allnoconfig plus these and kernel-<arch>.config;
# nix/packages.nix checks each line of both stuck). Everything built in, no modules, no NIC (vsock and
# loopback only). Cloud Hypervisor's devices are virtio-pci (MSI-X), so PCI is in; the serial console is
# per arch (kernel-<arch>.config).
# What apps expect of a Linux box (compat/): IPv6 (if only on lo), inotify, a wall clock (an RTC on arm64,
# kvm-clock on x86_64: else guests start at 1970), and cgroup v2 (apps read /proc/self/cgroup and their limits).
# A dummy NIC gives apps a private address to advertise (cassandra, alertmanager); it goes nowhere.
# xattrs and POSIX ACLs (security.* included) on the image, the scratch and tmpfs: file capabilities
# in images, and apps that setcap at start (vault).
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_MULTIUSER=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_MENU=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO_PCI=y
CONFIG_EXT4_FS=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_SYSVIPC=y
CONFIG_IPV6=y
CONFIG_INOTIFY_USER=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_DUMMY=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
