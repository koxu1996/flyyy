# arm64 only (with kernel.config): 4K pages even though the host is 16K; the devices from the device tree
# (OF); Cloud Hypervisor's serial is a PL011 (ttyAMA0, an AMBA device) and its wall clock a PL031 RTC; the
# PCI host bridge is the generic ECAM one. Power-off is PSCI (ARM64 selects ARM_PSCI_FW).
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM_AMBA=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_PCI_HOST_GENERIC=y
