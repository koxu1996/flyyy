# x86_64 only (with kernel.config): Cloud Hypervisor boots vmlinux at its PVH entry point; its serial is
# an 8250 at the legacy port (ttyS0); ACPI is how the guest powers off (Cloud Hypervisor exits on an ACPI
# shutdown but reboots the VM on a reset, so init ends the VM with a power-off, not a panic); kvm-clock (a
# KVM guest's paravirt clock) is the wall clock, so guests don't start at 1970; SMP and the MP table
# Cloud Hypervisor writes, for more than one vCPU (allnoconfig has neither on x86).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_ACPI=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PVH=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_SMP=y
CONFIG_X86_MPPARSE=y
